# Environment Variables Example
# Next.js Public site URL
NEXT_PUBLIC_SITE_URL=https://dassatyajitdas2005.github.io/my_portfolio/

# Optional: Web3Forms Access Key for Contact Form (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Optional: Google Gemini API Key for dynamic AI chat responses
# Get your free key at: https://aistudio.google.com/
# If not set, SD AI uses its built-in intelligent knowledge engine fallback automatically!
# GEMINI_API_KEY=your_gemini_api_key_here
